# Copy to .env.local — Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL for SEO (canonical, sitemap) — use your real domain when deployed
NEXT_PUBLIC_SITE_URL=https://www.organicfruithouse.com

# Legacy Vite names (still supported as fallback):
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
# VITE_SITE_URL=...

# Database (Supabase Dashboard → SQL):
# 1. New project: run supabase/schema.sql once
# 2. Existing DB with open write policies: run supabase/migrations/002_admin_auth.sql
# 3. Later changes: supabase/migrations/NNN_description.sql (in order)
#
# Deploy (Vercel etc.): set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
# in the hosting dashboard, then redeploy.

# Admin setup:
# 1. Authentication → Providers → enable Email
# 2. Authentication → Users → Add user (email + password)
# 3. SQL: insert into admin_users (user_id) values ('<user-uuid>');
# 4. Sign in at /admin/login (not linked from the public store)
