# Copy to .env — Supabase: Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site URL for SEO (canonical, sitemap) — use your real domain when deployed
VITE_SITE_URL=https://organicfoods.pk

# Database (Supabase Dashboard → SQL):
# 1. New project: run supabase/schema.sql once
# 2. Existing DB with open write policies: run supabase/migrations/002_admin_auth.sql
# 3. Later changes: supabase/migrations/NNN_description.sql (in order)
#    Include 004_product_images_storage.sql for admin image uploads + name fixes
#    Include 005_product_price_range.sql for single vs range pricing
#    Include 006_product_unit_range.sql for size ranges like 9 – 10 kg
#    Include 007_product_discount.sql for optional percentage discounts
#    Include 008_category_image_and_visibility.sql for category images and hide/show

# Admin setup:
# 1. Authentication → Providers → enable Email
# 2. Authentication → Users → Add user (email + password)
# 3. SQL: insert into admin_users (user_id) values ('<user-uuid>');
# 4. Sign in at /admin/login (not linked from the public store)
